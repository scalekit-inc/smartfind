{
  "name": "smartfind",
  "version": "0.1.0",
  "private": true,
  "description": "Provider SMART on FHIR discovery demo site + smartfind package",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "build:package": "npm run build --prefix packages/smartfind",
    "dev": "npm run build:package && next dev -H 127.0.0.1 -p 3847",
    "build": "npm run build:package && next build",
    "start": "next start -H 127.0.0.1 -p 3847",
    "lint": "eslint .",
    "cli": "npm run build:package && node packages/smartfind/dist/cli.js"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smartfind": "file:packages/smartfind"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
